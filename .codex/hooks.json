{
  "description": "Check the research repository before a Codex turn ends.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/stop_check.py\"",
            "commandWindows": "powershell -NoProfile -Command \"$p=Join-Path (git rev-parse --show-toplevel) '.codex/hooks/stop_check.py'; python $p\"",
            "timeout": 60,
            "statusMessage": "Checking research code"
          }
        ]
      }
    ]
  }
}
